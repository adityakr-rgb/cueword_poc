# Copy to .env.local. NEXT_PUBLIC_* are inlined into the browser bundle at BUILD time.
# BOTH apps (student + coach) must point at the SAME Supabase project for the
# cross-domain realtime live-class sync to work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Zoom Chat bot (optional) -----------------------------------------------
# Create a "Server-to-Server OAuth" app at https://marketplace.zoom.us
# Required scopes: chat_message:write:admin
# If these are absent the route silently no-ops and the class still works.
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_COACH_EMAIL=coach@yourcompany.com   # coach's Zoom account email
