{
  "name": "cueword-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:student": "npm run dev --workspace=@cueword/student",
    "dev:coach": "npm run dev --workspace=@cueword/coach",
    "build": "npm run build --workspaces --if-present",
    "build:student": "npm run build --workspace=@cueword/student",
    "build:coach": "npm run build --workspace=@cueword/coach",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:int": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "vitest run tests/unit && vitest run tests/integration && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.8.4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
