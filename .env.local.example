# Copy to .env.local and fill in from your Supabase project (Settings → API).
# NEXT_PUBLIC_* are exposed to the browser (used for reads + Realtime).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only — used by /api/admin for provisioning. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: point Playwright E2E at a deployed URL instead of the local dev server.
# E2E_BASE_URL=https://your-app.vercel.app
